<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.iot.mapper.EdgeDeviceMapper">
    
    <resultMap type="EdgeDevice" id="EdgeDeviceResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="status"    column="status"    />
        <result property="protocolId"    column="protocol_id"    />
        <result property="configuration"    column="configuration"    />
        <result property="description"    column="description"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectEdgeDeviceVo">
        select id, name, status, protocol_id, configuration, description, create_by, create_time, update_time from edge_device
    </sql>

    <select id="selectEdgeDeviceList" parameterType="EdgeDevice" resultMap="EdgeDeviceResult">
        <include refid="selectEdgeDeviceVo"/>
        <where>  
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="protocolId != null  and protocolId != ''"> and protocol_id = #{protocolId}</if>
            <if test="configuration != null  and configuration != ''"> and configuration = #{configuration}</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
        </where>
    </select>
    
    <select id="selectEdgeDeviceById" parameterType="String" resultMap="EdgeDeviceResult">
        <include refid="selectEdgeDeviceVo"/>
        where id = #{id}
    </select>

    <insert id="insertEdgeDevice" parameterType="EdgeDevice">
        insert into edge_device
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="name != null">name,</if>
            <if test="status != null">status,</if>
            <if test="protocolId != null">protocol_id,</if>
            <if test="configuration != null">configuration,</if>
            <if test="description != null">description,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="name != null">#{name},</if>
            <if test="status != null">#{status},</if>
            <if test="protocolId != null">#{protocolId},</if>
            <if test="configuration != null">#{configuration},</if>
            <if test="description != null">#{description},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateEdgeDevice" parameterType="EdgeDevice">
        update edge_device
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
            <if test="status != null">status = #{status},</if>
            <if test="protocolId != null">protocol_id = #{protocolId},</if>
            <if test="configuration != null">configuration = #{configuration},</if>
            <if test="description != null">description = #{description},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <update id="updateEdgeDeviceStatus" parameterType="EdgeDevice">
        update edge_device
        set status = #{status}, update_time = #{updateTime}
        where id = #{id}
    </update>

    <delete id="deleteEdgeDeviceById" parameterType="String">
        delete from edge_device where id = #{id}
    </delete>

    <delete id="deleteEdgeDeviceByIds" parameterType="String">
        delete from edge_device where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectEdgeDeviceStatistics" resultType="com.ruoyi.iot.domain.EdgeDeviceStatistics">
        select
            count(*) as total,
            0 as online,
            0 as offline,
            coalesce(sum(case when status = 'enable' then 1 else 0 end), 0) as enabled,
            coalesce(sum(case when status = 'disable' then 1 else 0 end), 0) as disabled
        from edge_device
    </select>
</mapper>

<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.iot.mapper.ProductCategoriesMapper">
    
    <resultMap type="ProductCategory" id="ProductCategoriesResult">
        <result property="categoryId"    column="category_id"    />
        <result property="parentId"    column="parent_id"    />
        <result property="ancestors"    column="ancestors"    />
        <result property="categoryName"    column="category_name"    />
        <result property="orderNum"    column="order_num"    />
        <result property="description"    column="description"    />
        <result property="status"    column="status"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectProductCategoriesVo">
        select category_id, parent_id, ancestors, category_name, order_num, description, status, del_flag, create_by, create_time, update_by, update_time from product_categories
    </sql>

    <select id="selectProductCategoriesList" parameterType="ProductCategory" resultMap="ProductCategoriesResult">
        <include refid="selectProductCategoriesVo"/>
        <where>  
            <if test="parentId != null "> and parent_id = #{parentId}</if>
            <if test="ancestors != null  and ancestors != ''"> and ancestors = #{ancestors}</if>
            <if test="categoryName != null  and categoryName != ''"> and category_name like concat('%', #{categoryName}, '%')</if>
            <if test="orderNum != null "> and order_num = #{orderNum}</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectProductCategoriesByCategoryId" parameterType="Long" resultMap="ProductCategoriesResult">
        <include refid="selectProductCategoriesVo"/>
        where category_id = #{categoryId}
    </select>

    <select id="selectChildrenCategoryById" resultType="ProductCategory">
        select * from product_categories where find_in_set(#{categoryId}, ancestors)
    </select>

    <select id="checkCategoryNameUnique" resultMap="ProductCategoriesResult">
        <include refid="selectProductCategoriesVo"/>
        where category_name=#{categoryName} and parent_id = #{parentId} and del_flag = '0' limit 1
    </select>

    <select id="selectNormalChildrenCategoryById" parameterType="Long" resultType="java.lang.Integer">
        select count(*) from product_categories where status = 0 and del_flag = '0' and find_in_set(#{categoryId}, ancestors)
    </select>
    <select id="hasChildByCategoryIds"  parameterType="String" resultType="java.lang.Integer">
        SELECT count(*) FROM product_categories
        WHERE del_flag = '0' and parent_id IN
        <foreach collection="array" item="categoryId" open="(" separator="," close=")">
            #{categoryId}
        </foreach>
    </select>

    <insert id="insertProductCategories" parameterType="ProductCategory">
        insert into product_categories
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="categoryId != null">category_id,</if>
            <if test="parentId != null">parent_id,</if>
            <if test="ancestors != null">ancestors,</if>
            <if test="categoryName != null">category_name,</if>
            <if test="orderNum != null">order_num,</if>
            <if test="description != null">description,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="categoryId != null">#{categoryId},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="ancestors != null">#{ancestors},</if>
            <if test="categoryName != null">#{categoryName},</if>
            <if test="orderNum != null">#{orderNum},</if>
            <if test="description != null">#{description},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateProductCategories" parameterType="ProductCategory">
        update product_categories
        <trim prefix="SET" suffixOverrides=",">
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="ancestors != null">ancestors = #{ancestors},</if>
            <if test="categoryName != null">category_name = #{categoryName},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null">status = #{status},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where category_id = #{categoryId}
    </update>
    <update id="updateCategoryStatusNormal">
        update product_categories set status = '0' where category_id in
        <foreach collection="array" item="categoryId" open="(" separator="," close=")">
            #{categoryId}
        </foreach>
    </update>

    <update id="updateCategoryChildren" parameterType="java.util.List">
        update product_categories set ancestors =
        <foreach collection="categories" item="item" index="index"
                 separator=" " open="case category_id" close="end">
            when #{item.categoryId} then #{item.ancestors}
        </foreach>
        where category_id in
        <foreach collection="categories" item="item" index="index"
                 separator="," open="(" close=")">
            #{item.categoryId}
        </foreach>
    </update>

    <delete id="deleteProductCategoriesByCategoryId" parameterType="Long">
        delete from product_categories where category_id = #{categoryId}
    </delete>

    <delete id="deleteProductCategoriesByCategoryIds" parameterType="String">
        delete from product_categories where category_id in 
        <foreach item="categoryId" collection="array" open="(" separator="," close=")">
            #{categoryId}
        </foreach>
    </delete>
</mapper>
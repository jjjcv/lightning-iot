<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.iot.mapper.TransportProtocolMapper">
    
    <resultMap type="TransportProtocol" id="TransportProtocolResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="description"    column="description"    />
        <result property="status"    column="status"    />
        <result property="configuration"    column="configuration"    />
        <result property="protocolType"    column="protocol_type"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectTransportProtocolVo">
        select id, name, description, status, configuration, protocol_type, create_by, create_time, update_by, update_time, remark from transport_protocol
    </sql>

    <select id="selectTransportProtocolList" parameterType="TransportProtocol" resultMap="TransportProtocolResult">
        <include refid="selectTransportProtocolVo"/>
        <where>  
            <if test="id != null  and id != ''"> and id = #{id}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="configuration != null  and configuration != ''"> and configuration = #{configuration}</if>
            <if test="protocolType != null  and protocolType != ''"> and protocol_type = #{protocolType}</if>
        </where>
    </select>
    
    <select id="selectTransportProtocolById" parameterType="String" resultMap="TransportProtocolResult">
        <include refid="selectTransportProtocolVo"/>
        where id = #{id}
    </select>

    <insert id="insertTransportProtocol" parameterType="TransportProtocol">
        insert into transport_protocol
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="name != null">name,</if>
            <if test="description != null">description,</if>
            <if test="status != null">status,</if>
            <if test="configuration != null">configuration,</if>
            <if test="protocolType != null">protocol_type,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="name != null">#{name},</if>
            <if test="description != null">#{description},</if>
            <if test="status != null">#{status},</if>
            <if test="configuration != null">#{configuration},</if>
            <if test="protocolType != null">#{protocolType},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateTransportProtocol" parameterType="TransportProtocol">
        update transport_protocol
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null">status = #{status},</if>
            <if test="configuration != null">configuration = #{configuration},</if>
            <if test="protocolType != null">protocol_type = #{protocolType},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteTransportProtocolById" parameterType="String">
        delete from transport_protocol where id = #{id}
    </delete>

    <delete id="deleteTransportProtocolByIds" parameterType="String">
        delete from transport_protocol where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
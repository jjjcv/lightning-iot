<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.iot.mapper.AlarmLogMapper">
    
    <resultMap type="AlarmLog" id="AlarmLogResult">
        <result property="id"    column="id"    />
        <result property="productId"    column="product_id"    />
        <result property="productName"    column="product_name"    />
        <result property="deviceId"    column="device_id"    />
        <result property="deviceName"    column="device_name"    />
        <result property="telemetryKey"    column="telemetry_key"    />
        <result property="telemetryName"    column="telemetry_name"    />
        <result property="telemetryValue"    column="telemetry_value"    />
        <result property="triggerDesc"    column="trigger_desc"    />
        <result property="alarmDesc"    column="alarm_desc"    />
        <result property="alarmTime"    column="alarm_time"    />
        <result property="handleMessage"    column="handle_message"    />
        <result property="handleTime"    column="handle_time"    />
        <result property="level"    column="level"    />
        <result property="state"    column="state"    />
        <result property="handleType"    column="handle_type"    />
        <result property="description"    column="description"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectAlarmLogVo">
        select id, product_id, product_name, device_id, device_name, telemetry_key, telemetry_name, telemetry_value, trigger_desc, alarm_desc, alarm_time, handle_message, handle_time, level, state, handle_type, description, create_time from alarm_log
    </sql>

    <select id="selectAlarmLogList" parameterType="AlarmLog" resultMap="AlarmLogResult">
        <include refid="selectAlarmLogVo"/>
        <where>  
            <if test="productId != null  and productId != ''"> and product_id = #{productId}</if>
            <if test="productName != null  and productName != ''"> and product_name like concat('%', #{productName}, '%')</if>
            <if test="deviceId != null  and deviceId != ''"> and device_id = #{deviceId}</if>
            <if test="deviceName != null  and deviceName != ''"> and device_name like concat('%', #{deviceName}, '%')</if>
            <if test="telemetryKey != null  and telemetryKey != ''"> and telemetry_key = #{telemetryKey}</if>
            <if test="telemetryName != null  and telemetryName != ''"> and telemetry_name like concat('%', #{telemetryName}, '%')</if>
            <if test="telemetryValue != null  and telemetryValue != ''"> and telemetry_value = #{telemetryValue}</if>
            <if test="triggerDesc != null  and triggerDesc != ''"> and trigger_desc = #{triggerDesc}</if>
            <if test="alarmDesc != null  and alarmDesc != ''"> and alarm_desc = #{alarmDesc}</if>
            <if test="alarmTime != null "> and alarm_time = #{alarmTime}</if>
            <if test="handleMessage != null  and handleMessage != ''"> and handle_message = #{handleMessage}</if>
            <if test="handleTime != null "> and handle_time = #{handleTime}</if>
            <if test="level != null "> and level = #{level}</if>
            <if test="state != null  and state != ''"> and state = #{state}</if>
            <if test="handleType != null "> and handle_type = #{handleType}</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
        </where>
    </select>
    
    <select id="selectAlarmLogById" parameterType="Long" resultMap="AlarmLogResult">
        <include refid="selectAlarmLogVo"/>
        where id = #{id}
    </select>

    <insert id="insertAlarmLog" parameterType="AlarmLog" useGeneratedKeys="true" keyProperty="id">
        insert into alarm_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="productId != null">product_id,</if>
            <if test="productName != null">product_name,</if>
            <if test="deviceId != null">device_id,</if>
            <if test="deviceName != null">device_name,</if>
            <if test="telemetryKey != null">telemetry_key,</if>
            <if test="telemetryName != null">telemetry_name,</if>
            <if test="telemetryValue != null">telemetry_value,</if>
            <if test="triggerDesc != null">trigger_desc,</if>
            <if test="alarmDesc != null">alarm_desc,</if>
            <if test="alarmTime != null">alarm_time,</if>
            <if test="handleMessage != null">handle_message,</if>
            <if test="handleTime != null">handle_time,</if>
            <if test="level != null">level,</if>
            <if test="state != null">state,</if>
            <if test="handleType != null">handle_type,</if>
            <if test="description != null">description,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="productId != null">#{productId},</if>
            <if test="productName != null">#{productName},</if>
            <if test="deviceId != null">#{deviceId},</if>
            <if test="deviceName != null">#{deviceName},</if>
            <if test="telemetryKey != null">#{telemetryKey},</if>
            <if test="telemetryName != null">#{telemetryName},</if>
            <if test="telemetryValue != null">#{telemetryValue},</if>
            <if test="triggerDesc != null">#{triggerDesc},</if>
            <if test="alarmDesc != null">#{alarmDesc},</if>
            <if test="alarmTime != null">#{alarmTime},</if>
            <if test="handleMessage != null">#{handleMessage},</if>
            <if test="handleTime != null">#{handleTime},</if>
            <if test="level != null">#{level},</if>
            <if test="state != null">#{state},</if>
            <if test="handleType != null">#{handleType},</if>
            <if test="description != null">#{description},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateAlarmLog" parameterType="AlarmLog">
        update alarm_log
        <trim prefix="SET" suffixOverrides=",">
            <if test="productId != null">product_id = #{productId},</if>
            <if test="productName != null">product_name = #{productName},</if>
            <if test="deviceId != null">device_id = #{deviceId},</if>
            <if test="deviceName != null">device_name = #{deviceName},</if>
            <if test="telemetryKey != null">telemetry_key = #{telemetryKey},</if>
            <if test="telemetryName != null">telemetry_name = #{telemetryName},</if>
            <if test="telemetryValue != null">telemetry_value = #{telemetryValue},</if>
            <if test="triggerDesc != null">trigger_desc = #{triggerDesc},</if>
            <if test="alarmDesc != null">alarm_desc = #{alarmDesc},</if>
            <if test="alarmTime != null">alarm_time = #{alarmTime},</if>
            <if test="handleMessage != null">handle_message = #{handleMessage},</if>
            <if test="handleTime != null">handle_time = #{handleTime},</if>
            <if test="level != null">level = #{level},</if>
            <if test="state != null">state = #{state},</if>
            <if test="handleType != null">handle_type = #{handleType},</if>
            <if test="description != null">description = #{description},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAlarmLogById" parameterType="Long">
        delete from alarm_log where id = #{id}
    </delete>

    <delete id="deleteAlarmLogByIds" parameterType="String">
        delete from alarm_log where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.iot.mapper.UnitMapper">
    
    <resultMap type="Unit" id="UnitResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="symbol"    column="symbol"    />
        <result property="categoryId"    column="category_id"    />
        <result property="conversionFactor"    column="conversion_factor"    />
        <result property="isBaseUnit"    column="is_base_unit"    />
        <result property="description"    column="description"    />
        <result property="createdTime"    column="created_time"    />
        <result property="updatedTime"    column="updated_time"    />
    </resultMap>

    <sql id="selectUnitVo">
        select id, name, symbol, category_id, conversion_factor, is_base_unit, description, created_time, updated_time from unit
    </sql>

    <select id="selectUnitList" parameterType="Unit" resultMap="UnitResult">
        <include refid="selectUnitVo"/>
        <where>  
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="symbol != null  and symbol != ''"> and symbol = #{symbol}</if>
            <if test="categoryId != null "> and category_id = #{categoryId}</if>
            <if test="conversionFactor != null "> and conversion_factor = #{conversionFactor}</if>
            <if test="isBaseUnit != null "> and is_base_unit = #{isBaseUnit}</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
            <if test="createdTime != null "> and created_time = #{createdTime}</if>
            <if test="updatedTime != null "> and updated_time = #{updatedTime}</if>
        </where>
    </select>
    
    <select id="selectUnitById" parameterType="Long" resultMap="UnitResult">
        <include refid="selectUnitVo"/>
        where id = #{id}
    </select>

    <insert id="insertUnit" parameterType="Unit" useGeneratedKeys="true" keyProperty="id">
        insert into unit
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">name,</if>
            <if test="symbol != null and symbol != ''">symbol,</if>
            <if test="categoryId != null">category_id,</if>
            <if test="conversionFactor != null">conversion_factor,</if>
            <if test="isBaseUnit != null">is_base_unit,</if>
            <if test="description != null">description,</if>
            <if test="createdTime != null">created_time,</if>
            <if test="updatedTime != null">updated_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">#{name},</if>
            <if test="symbol != null and symbol != ''">#{symbol},</if>
            <if test="categoryId != null">#{categoryId},</if>
            <if test="conversionFactor != null">#{conversionFactor},</if>
            <if test="isBaseUnit != null">#{isBaseUnit},</if>
            <if test="description != null">#{description},</if>
            <if test="createdTime != null">#{createdTime},</if>
            <if test="updatedTime != null">#{updatedTime},</if>
         </trim>
    </insert>

    <update id="updateUnit" parameterType="Unit">
        update unit
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="symbol != null and symbol != ''">symbol = #{symbol},</if>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="conversionFactor != null">conversion_factor = #{conversionFactor},</if>
            <if test="isBaseUnit != null">is_base_unit = #{isBaseUnit},</if>
            <if test="description != null">description = #{description},</if>
            <if test="createdTime != null">created_time = #{createdTime},</if>
            <if test="updatedTime != null">updated_time = #{updatedTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteUnitById" parameterType="Long">
        delete from unit where id = #{id}
    </delete>

    <delete id="deleteUnitByIds" parameterType="String">
        delete from unit where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
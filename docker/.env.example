# 可选配置：复制为 .env 后手动修改。未创建 .env 时使用 Compose 中相同的默认值。
# 修改 MQTT 用户名/密码时，需同步修改 nanomq/nanomq_pwd.conf。
COMPOSE_PROJECT_NAME=lightning-iot
TZ=Asia/Shanghai
HTTP_PORT=8798
MQTT_PORT=1883
MYSQL_IMAGE=mysql:8.0
REDIS_IMAGE=redis:7.4-alpine
INFLUXDB_IMAGE=influxdb:2.7
NANOMQ_IMAGE=emqx/nanomq:0.25.6
JAVA_IMAGE=eclipse-temurin:21-jre-jammy
NGINX_IMAGE=nginx:1.28-alpine
JAVA_TOOL_OPTIONS=-Xms256m -Xmx1024m -Duser.timezone=Asia/Shanghai
MYSQL_DATABASE=lightning
MYSQL_USERNAME=lightning
MYSQL_PASSWORD=lightning123
MYSQL_ROOT_PASSWORD=lightningRoot123
REDIS_PASSWORD=lightningRedis123
TOKEN_SECRET=lightning-iot-token-secret-change-me-before-production-2026
DRUID_ADMIN_PASSWORD=lightningDruid123
INFLUX_USERNAME=lightning
INFLUX_PASSWORD=lightningInflux123
INFLUX_ORG=lightning
INFLUX_BUCKET=device_history
INFLUX_TOKEN=lightning-iot-influx-token-change-me-before-production-2026
NANOMQ_USERNAME=admin
NANOMQ_PASSWORD=lightningMqtt123
